# Local MySQL environment variables
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_USER_PASSWORD=

# Docker MySQL environment variables
DOCKER_MYSQL_PORT=3366
DOCKER_DB_NAME=TerminPilot
DOCKER_DB_USER=User
DOCKER_DB_USER_PASSWORD=your_docker_db_user_password_here
DOCKER_DB_ROOT_PASSWORD=your_docker_db_root_password_here

# Google OAuth 2.0 Credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/google/callback
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# GitHub environment variables for GitHub Packages
GITHUB_ACTOR=<GITHUB_USERNAME>
# needed scope for api spec download: read:packages
GITHUB_TOKEN=your_github_token_here
