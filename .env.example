# Local MySQL environment variables
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_USER_PASSWORD=

# Docker MySQL environment variables
DOCKER_MYSQL_PORT=3366
DOCKER_DB_NAME=TerminPilot
DOCKER_DB_USER=User
DOCKER_DB_USER_PASSWORD=UserPassword
DOCKER_DB_ROOT_PASSWORD=RootPassword

# Google OAuth 2.0 Credentials
google.oauth.client-id=<Client.id>
google.oauth.client-secret=<client-secret>
google.oauth.redirect-uri=http://localhost:8080/api/google/callback

# Apple Calendar real integration test (optional, local only)
# Never commit real Apple credentials.
APPLE_TEST_EMAIL=
APPLE_TEST_APP_PASSWORD=
APPLE_TEST_CALENDAR_NAME=
APPLE_REAL_INTEGRATION_TEST_ENABLED=false

# TerminPilot encryption key for stored credentials (AES-256-GCM, Base64-encoded 32 bytes)
# Generate: openssl rand -base64 32
# TERMINPILOT_ENCRYPTION_KEY=<your-generated-key>

# GitHub environment variables for GitHub Packages
GITHUB_ACTOR=<GITHUB_USERNAME>
# needed scope for api spec download: read:packages
GITHUB_TOKEN=<GITHUB_PERSONAL_ACCESS_TOKEN>
