{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-6 * * *"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,

  "labels": ["renovate"],
  "rebaseWhen": "behind-base-branch",
  "automerge": true,
  "platformAutomerge": true,

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },

  "packageRules": [
    {
      "description": "Major Updates: Create PR, but no Auto-Merge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["renovate", "major update"]
    },
    {
      "description": "Ignore PR snapshot versions of internal API spec",
      "matchDatasources": ["maven"],
      "matchPackageNames": ["de.stammtischhub:terminpilot-api-spec"],
      "ignoreUnstable": "true"
    }
  ]
}
