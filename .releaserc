{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo \"new_version=${nextRelease.version}\" >> $GITHUB_OUTPUT && mv build/libs/terminpilot-backend.jar build/libs/terminpilot-backend-${nextRelease.version}.jar"
      }
    ],

    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/libs/terminpilot-backend-*.jar",
            "label": "terminpilot-backend-${nextRelease.version}.jar"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "build.gradle.kts"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}